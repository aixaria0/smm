# SMM talks to any OpenAI-compatible inference server.
# Local examples: llama.cpp server, Ollama's OpenAI endpoint, vLLM, LocalAI.
SMM_PROVIDER_URL=http://127.0.0.1:11434/v1
SMM_MODEL=
SMM_API_KEY=

SMM_PORT=8787
SMM_HOST=127.0.0.1
SMM_MODE=balanced
SMM_MEMORY_PATH=.smm/memory.jsonl
SMM_LEDGER_PATH=.smm/ledger.jsonl
SMM_MEMORY_ENABLED=true
SMM_MAX_BODY_BYTES=1048576
SMM_RATE_LIMIT_PER_MINUTE=60
SMM_CORS_ORIGIN=*
